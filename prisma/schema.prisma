// Schéma de la base de données — Compta e-commerce
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // "native" pour le local, "rhel-openssl-3.0.x" pour l'environnement Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  // URL "de secours" utilisée uniquement par les commandes Prisma en local.
  // En vrai, la connexion se fait via l'adaptateur libSQL (Turso) — voir
  // lib/prisma.ts — avec les variables TURSO_DATABASE_URL / TURSO_AUTH_TOKEN.
  url      = "file:./dev.db"
}

/// Catalogue produit : un article vendu avec son prix d'achat (coût).
model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  costPrice Float // Prix d'achat unitaire (€)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items DailyEntryItem[]
}

/// Saisie d'une journée : les champs saisis manuellement.
/// Les indicateurs (marge, ROAS, prix moyens) sont calculés à la volée.
model DailyEntry {
  id           String   @id @default(cuid())
  date         DateTime @unique // Jour concerné (à minuit UTC)
  ordersCount  Int      @default(0) // Nombre de commandes
  revenue      Float    @default(0) // CA du jour (€)
  tiktokSpend  Float    @default(0) // Dépense publicitaire TikTok (€)
  purchaseCost Float    @default(0) // Coût d'achat total des produits vendus (€)
  note         String? // Commentaire libre optionnel
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items DailyEntryItem[]
}

/// Détail optionnel : quels produits ont été vendus ce jour (quantité).
/// Si présent, la somme (quantité × prix d'achat) alimente purchaseCost.
model DailyEntryItem {
  id        String     @id @default(cuid())
  entry     DailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId   String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String
  quantity  Int        @default(1)

  @@unique([entryId, productId])
}

/// Boutique concurrente surveillée par le radar best-sellers.
/// Ajoutée depuis /radar ; le scan quotidien lit cette table.
model RadarSite {
  id        String   @id @default(cuid())
  domain    String   @unique // Domaine nu, ex. "exemple.com"
  createdAt DateTime @default(now())
}

/// Photo du classement d'une boutique à une date donnée. C'est la référence
/// contre laquelle le scan suivant se compare : sans elle, pas de mouvements.
/// Un seul enregistrement par site et par jour — un second scan dans la même
/// journée écrase le précédent plutôt que de fausser le diff du lendemain.
model RadarSnapshot {
  id        String   @id @default(cuid())
  domain    String
  date      String // "AAAA-MM-JJ"
  scannedAt DateTime @default(now())
  payload   String // JSON : order, products, boundary, confidence, warning

  @@unique([domain, date])
}

/// Rapport complet affiché par /radar, dans le même format que data/radar.json.
model RadarReport {
  id          String   @id @default(cuid())
  date        String   @unique // "AAAA-MM-JJ"
  generatedAt DateTime @default(now())
  payload     String // JSON du tableau de bord
}

/// Un scan lancé depuis l'application. Le client avance site par site et lit
/// cette ligne pour dessiner la barre de progression.
model RadarRun {
  id        String    @id @default(cuid())
  status    String    @default("running") // running | done | error
  domains   String // JSON : les domaines à scanner, dans l'ordre
  done      Int       @default(0)
  results   String    @default("[]") // JSON : les fiches de site déjà produites
  current   String? // Domaine en cours, pour l'afficher pendant le scan
  error     String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
}
